{# templates/ai/page_speed_dashboard.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}🚀 AI Page Speed Analysis for {{ url }}{% endblock %}

{% block body %}
  <style>
    body {
      background: linear-gradient(135deg, #1e3c72, #2a5298);
      color: #fff;
      font-family: 'Segoe UI', sans-serif;
      margin: 0;
      padding: 0;
      min-height: 100vh;
    }
    h1, h2 {
      text-align: center;
      margin-bottom: 1rem;
      margin-top: 0;
    }
    .dashboard-container {
      max-width: 1200px;
      margin: 0 auto;
      padding: 2rem;
    }
    .card {
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
      backdrop-filter: blur(10px);
    }
    .metric-list {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 1rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .metric-list li {
      background: rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      padding: 1rem;
      text-align: center;
      font-size: 0.95rem;
      transition: all 0.3s ease;
    }
    .metric-list li:hover {
      background: rgba(255, 255, 255, 0.15);
      transform: translateY(-2px);
    }
    .metric-list strong {
      display: block;
      font-size: 1.1rem;
      color: #ffd700;
      margin-bottom: 0.5rem;
    }
    .metric-list li:last-child {
      color: #e0e0e0;
      font-size: 0.9rem;
    }
    .badge {
      display: inline-block;
      background: #00ffcc;
      color: #000;
      padding: 0.3rem 0.8rem;
      border-radius: 6px;
      font-weight: bold;
      margin-top: 0.5rem;
      font-size: 0.9rem;
      word-break: break-all;
    }
    .text-center {
      text-align: center;
    }
    .text-muted {
      color: rgba(255, 255, 255, 0.7);
      font-size: 0.9rem;
    }
    .charts-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 1.5rem;
      margin-top: 1.5rem;
    }
    .chart-box {
      background: rgba(255, 255, 255, 0.05);
      border-radius: 8px;
      padding: 1.5rem;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }
    .chart-box h3 {
      text-align: center;
      margin: 0 0 1.5rem 0;
      font-size: 1.1rem;
      color: #ffffff;
    }
    .chart-box canvas {
      max-height: 400px;
    }
    .hero-section {
      background: linear-gradient(135deg, rgba(0, 255, 204, 0.1), rgba(255, 215, 0, 0.05));
      border: 2px solid rgba(0, 255, 204, 0.3);
      border-radius: 16px;
      padding: 3rem 2rem;
      margin-bottom: 2rem;
      text-align: center;
      backdrop-filter: blur(10px);
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
    }
    .hero-section h1 {
      font-size: 2.5rem;
      margin: 0 0 1.5rem 0;
      background: linear-gradient(135deg, #00ffcc, #ffd700);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      font-weight: 700;
      letter-spacing: 0.5px;
    }
    .hero-section p {
      margin: 0;
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.8);
    }
    .url-badge {
      display: inline-block;
      background: linear-gradient(135deg, rgba(0, 255, 204, 0.2), rgba(255, 215, 0, 0.15));
      border: 1px solid rgba(0, 255, 204, 0.4);
      color: #00ffcc;
      padding: 0.8rem 1.5rem;
      border-radius: 8px;
      font-weight: 500;
      margin-top: 1rem;
      font-size: 0.95rem;
      word-break: break-all;
      font-family: 'Courier New', monospace;
      max-width: 100%;
    }
    .timestamp {
      font-size: 0.85rem;
      color: rgba(255, 255, 255, 0.6);
      margin-top: 1rem;
      font-style: italic;
    }
  </style>

  <div class="dashboard-container">
    <!-- Hero Section -->
    <div class="hero-section">
      <h1>🚀 AI Page Speed Analysis</h1>
      <p>Analyzing website performance in real-time</p>
      <div class="url-badge">{{ url|e }}</div>
      <div class="timestamp">📅 Captured at {{ metrics.timestamp }}</div>
    </div>

    <!-- Page Metrics -->
    <div class="card">
      <h2>📄 Page Metrics</h2>
      <ul class="metric-list">
        <li><strong>Page Size</strong>{{ metrics.page_metrics.page_size_kb }} KB</li>
        <li><strong>Total Scripts</strong>{{ metrics.page_metrics.total_scripts }}</li>
        <li><strong>Total Images</strong>{{ metrics.page_metrics.total_images }}</li>
      </ul>
    </div>

    <!-- Loading Metrics -->
    <div class="card">
      <h2>⚡ Loading Metrics</h2>
      <ul class="metric-list">
        <li><strong>TTFB</strong>{{ metrics.loading_metrics.ttfb }} ms</li>
        <li><strong>DNS Time</strong>{{ metrics.loading_metrics.dns_time }} ms</li>
        <li><strong>SSL Handshake</strong>{{ metrics.loading_metrics.ssl_handshake_time }} ms</li>
        <li><strong>Connection Time</strong>{{ metrics.loading_metrics.connection_time }} ms</li>
        <li><strong>Download Time</strong>{{ metrics.loading_metrics.download_time }} ms</li>
      </ul>
    </div>

    <!-- Rendering Metrics -->
    <div class="card">
      <h2>🎨 Rendering Metrics</h2>
      <ul class="metric-list">
        <li><strong>FCP</strong>{{ metrics.rendering_metrics.fcp|round(2) }} ms</li>
        <li><strong>LCP</strong>{{ metrics.rendering_metrics.lcp|round(2) }} ms</li>
        <li><strong>CLS</strong>{{ metrics.rendering_metrics.cls }}</li>
        <li><strong>FMP</strong>{{ metrics.rendering_metrics.fmp ?? 'N/A' }}</li>
      </ul>
    </div>

    <!-- Interactivity Metrics -->
    <div class="card">
      <h2>🖱️ Interactivity Metrics</h2>
      <ul class="metric-list">
        <li><strong>TTI</strong>{{ metrics.interactivity_metrics.tti|round(2) }} ms</li>
        <li><strong>TBT</strong>{{ metrics.interactivity_metrics.tbt }}</li>
        <li><strong>INP</strong>{{ metrics.interactivity_metrics.inp ?? 'N/A' }}</li>
      </ul>
    </div>

    <!-- Performance Metrics -->
    <div class="card">
      <h2>🏆 Performance Metrics</h2>
      <ul class="metric-list">
        <li><strong>Performance Score</strong>{{ (metrics.performance_metrics.performance_score * 100)|round(0) }}%</li>
        <li><strong>Speed Index</strong>{{ metrics.performance_metrics.si|round(2) }} ms</li>
      </ul>
    </div>

    <!-- AI Analysis -->
    <div class="card">
      <h2>🤖 AI Analysis</h2>
      {% if ai_analysis is iterable %}
        {% for item in ai_analysis %}
          <pre style="
              background:#00000030;
              color:#00ffcc;
              padding:1rem;
              border-radius:8px;
              font-family:'Courier New', monospace;
              margin-bottom:1rem;
              text-align:justify;
              white-space: pre-wrap;
              word-wrap: break-word;
              overflow-x: hidden;
          ">{{ item|raw }}</pre>
        {% endfor %}
      {% else %}
        <pre style="
            background:#00000030;
            color:#00ffcc;
            padding:1rem;
            border-radius:8px;
            font-family:'Courier New', monospace;
            text-align:justify;
            white-space: pre-wrap;
            word-wrap: break-word;
            overflow-x: hidden;
        ">{{ ai_analysis }}</pre>
      {% endif %}
    </div>

    <!-- Chart representation of the Page Performance -->
    <div class="card">
      <h2>📊 Performance Metrics Charts</h2>
      <div class="charts-grid">
        <div class="chart-box">
          <h3>Bar Chart</h3>
          <canvas id="barChart1"></canvas>
        </div>
        <div class="chart-box">
          <h3>Radar Chart</h3>
          <canvas id="radarChart1"></canvas>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const metrics = {{ ai_performance_graph_metrics|json_encode|raw }};
      
      if (!Array.isArray(metrics) || metrics.length === 0) {
        console.warn('No metrics data available for charts');
        return;
      }
      
      const labels = metrics.map(m => m.label);
      const values = metrics.map(m => m.value);
      
      const chartDefaults = {
        responsive: true,
        maintainAspectRatio: true,
        plugins: {
          legend: {
            labels: { color: '#ffffff' }
          }
        }
      };

      // Bar Chart
      const barCtx = document.getElementById('barChart1');
      if (barCtx) {
        new Chart(barCtx, {
          type: 'bar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Performance %',
              data: values,
              backgroundColor: [
                'rgba(255, 99, 132, 0.8)',
                'rgba(54, 162, 235, 0.8)',
                'rgba(255, 206, 86, 0.8)',
                'rgba(75, 192, 192, 0.8)',
                'rgba(153, 102, 255, 0.8)',
                'rgba(255, 159, 64, 0.8)',
                'rgba(199, 199, 199, 0.8)'
              ],
              borderColor: [
                'rgba(255, 99, 132, 1)',
                'rgba(54, 162, 235, 1)',
                'rgba(255, 206, 86, 1)',
                'rgba(75, 192, 192, 1)',
                'rgba(153, 102, 255, 1)',
                'rgba(255, 159, 64, 1)',
                'rgba(199, 199, 199, 1)'
              ],
              borderWidth: 2,
              borderRadius: 4
            }]
          },
          options: {
            ...chartDefaults,
            indexAxis: 'y',
            scales: {
              x: { 
                beginAtZero: true, 
                max: 100,
                ticks: { color: '#ffffff' },
                grid: { color: 'rgba(255, 255, 255, 0.1)' }
              },
              y: {
                ticks: { color: '#ffffff' },
                grid: { color: 'rgba(255, 255, 255, 0.1)' }
              }
            }
          }
        });
      }

      // Radar Chart
      const radarCtx = document.getElementById('radarChart1');
      if (radarCtx) {
        new Chart(radarCtx, {
          type: 'radar',
          data: {
            labels: labels,
            datasets: [{
              label: 'Performance %',
              data: values,
              fill: true,
              backgroundColor: 'rgba(54, 162, 235, 0.25)',
              borderColor: 'rgba(54, 162, 235, 1)',
              borderWidth: 2,
              pointBackgroundColor: 'rgba(54, 162, 235, 1)',
              pointBorderColor: '#fff',
              pointBorderWidth: 2,
              pointRadius: 5,
              pointHoverBackgroundColor: '#fff',
              pointHoverBorderColor: 'rgba(54, 162, 235, 1)',
              pointHoverRadius: 7
            }]
          },
          options: {
            ...chartDefaults,
            scales: {
              r: {
                beginAtZero: true,
                max: 100,
                ticks: {
                  color: '#ffffff',
                  stepSize: 20
                },
                grid: { color: 'rgba(255, 255, 255, 0.1)' },
                angleLines: { color: 'rgba(255, 255, 255, 0.2)' }
              }
            }
          }
        });
      }
    });
  </script>
{% endblock %}